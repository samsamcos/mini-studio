# ── API Keys ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7819702619

# ── LLM Cascade (OmniRoute → Pollinations → Groq rush-only → defer) ──────────
# OmniRoute: your local LLM router (docker: diegosouzapw/omniroute:latest)
# Install on the same machine so it doesn't depend on other CTs:
#   docker run -d --name omniroute --restart unless-stopped \
#     -p 127.0.0.1:20128:20128 -e GROQ_API_KEY=<key> diegosouzapw/omniroute:latest
OMNIROUTE_URL=http://127.0.0.1:20128

# Pollinations free public LLM API
POLLINATIONS_URL=https://text.pollinations.ai

# ── STT — local Whisper first, Groq fallback ──────────────────────────────────
WHISPER_URL=http://127.0.0.1:8421

# ── TTS — Pocket TTS primary (Sam's voice clone), XTTS fallback ──────────────
POCKET_TTS_URL=http://192.168.0.235:5020
VOICE_WAV_PATH=/opt/studio/voices/voice_clone.wav
TTS_URL=http://127.0.0.1:8422

# ── OpenCut editor ────────────────────────────────────────────────────────────
OPENCUT_URL=http://192.168.0.78:9500

# ── Director network ──────────────────────────────────────────────────────────
DIRECTOR_HOST=192.168.0.78
DIRECTOR_PORT=9533

# ── Storage ───────────────────────────────────────────────────────────────────
PROJECTS_DIR=/opt/studio/projects
WATCH_DIR=/opt/studio/inbox
